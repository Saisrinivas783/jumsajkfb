# AWS Configuration
AWS_REGION=us-east-1
KENDRA_INDEX_ID=your-kendra-index-id

# Kendra Role Configuration (Optional)
# If specified, the agent will assume this role to access Kendra
# KENDRA_ROLE_ARN=arn:aws:iam::123456789012:role/KendraAccessRole
# KENDRA_SESSION_NAME=ibt-agent-kendra-session
# KENDRA_ROLE_DURATION=3600

# Bedrock Configuration (only needed when USE_LLM=true)
BEDROCK_MODEL_ID=meta.llama3-3-70b-instruct-v1:0
BEDROCK_TEMPERATURE=0.0
BEDROCK_MAX_TOKENS=1024

# Mode Configuration
# Set to 'false' for direct Kendra search (faster, deterministic)
# Set to 'true' for LLM-enhanced responses (conversational, context-aware)
USE_LLM=true

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Logging
LOG_LEVEL=INFO