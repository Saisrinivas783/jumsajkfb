# AWS Configuration
AWS_REGION=us-east-1
KENDRA_INDEX_ID=your-kendra-index-id

# Kendra Role Configuration (Optional)
# If specified, the agent will assume this role to access Kendra
# KENDRA_ROLE_ARN=arn:aws:iam::123456789012:role/KendraAccessRole
# KENDRA_SESSION_NAME=ibt-agent-kendra-session
# KENDRA_ROLE_DURATION=3600

# Assumed-role credential refresh buffer (minutes before expiration to refresh)
CREDENTIALS_REFRESH_BUFFER_MINUTES=5

# Kendra Search Configuration
# Number of documents Kendra returns per query (1-100)
KENDRA_PAGE_SIZE=10

# Kendra Client Timeout/Retry Configuration
KENDRA_READ_TIMEOUT=300
KENDRA_CONNECT_TIMEOUT=10
KENDRA_MAX_RETRIES=3

# STS Client Timeout/Retry Configuration (Kendra role assumption)
STS_CONNECT_TIMEOUT=5
STS_READ_TIMEOUT=10
STS_MAX_RETRIES=2

# Concurrency Configuration
# Max HTTP connection pool size for the Kendra boto3 client
KENDRA_MAX_POOL_CONNECTIONS=40
# Max HTTP connection pool size for the STS boto3 client (Kendra role assumption)
STS_MAX_POOL_CONNECTIONS=20

# Logging
LOG_LEVEL=INFO
