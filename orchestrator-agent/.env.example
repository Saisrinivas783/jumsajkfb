# AWS Credentials (Required)
# Get these from AWS IAM console
AWS_ACCESS_KEY_ID= ACCESS_KEY
AWS_SECRET_ACCESS_KEY=SECRET_KEY
AWS_DEFAULT_REGION=us-east-1

# AWS Bedrock Configuration
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_TEMPERATURE=0.0
BEDROCK_MAX_TOKENS=1024

# Timeout Configuration (in seconds)
BEDROCK_READ_TIMEOUT=300
BEDROCK_CONNECT_TIMEOUT=10
BEDROCK_MAX_RETRIES=3

# Extended Thinking (for Claude 3.5+ models)
EXTENDED_THINKING_ENABLED=false
EXTENDED_THINKING_MAX_TOKENS=16000
EXTENDED_THINKING_BUDGET_TOKENS=10000

# Guard Rails Configuration
CONFIDENCE_THRESHOLD_HIGH=7.0
CONFIDENCE_THRESHOLD_LOW=5.0

# Tool Execution Configuration
TOOL_TIMEOUT=30
TOOL_MAX_RETRIES=3

# Session Configuration
SESSION_TTL_SECONDS=1800
MAX_CONVERSATION_HISTORY=20

# Logging
LOG_LEVEL=INFO

# Registry Path
REGISTRY_PATH=src/tools/definitions/tools.yaml

##Guardrails
AWS_BEDROCK_GUARDRAIL_ID=your-guardrail-id                                                           
BEDROCK_GUARDRAIL_VERSION=1

## ReFormulated Query
USE_REFORMULATED_QUERY=false
